# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
JWT_SECRET_KEY=change_this_to_another_secure_key_for_jwt_tokens
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Database Configuration (PostgreSQL / Supabase or SQLite fallback)
# For local SQLite: sqlite:///apsrtc.db
# For PostgreSQL: postgresql://postgres:password@localhost:5432/apsrtc_db
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///apsrtc.db

# Storage / File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=5

# SMS Gateway Configuration (Twilio / MSG91 / Fast2SMS)
# Set SMS_PROVIDER=mock for development without live credentials
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=APSRTC
SMS_WEBHOOK_SECRET=test_webhook_secret_key

# Admin Setup
# On initial setup, if no admin exists, these credentials can be used or created via setup CLI
INITIAL_ADMIN_EMAIL=admin@apsrtc.ap.gov.in
INITIAL_ADMIN_NAME=APSRTC System Administrator
